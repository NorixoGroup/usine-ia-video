# Exemple de configuration pour le worker Nomad Studio (Docker).
# Fichier d'EXEMPLE : ne contient aucune valeur réelle, à copier et compléter
# localement (ex. worker.env, jamais commité — déjà exclu par .dockerignore
# et à ajouter à .gitignore si ce fichier est utilisé tel quel).
#
# Noms de variables confirmés par lecture directe du code (src/agents,
# src/orchestrator, src/render, src/services, src/media, src/utils) :

# --- Sécurité financière : valeur sûre par défaut ---
# "1" = aucun appel payant possible, quelle que soit la configuration ci-dessous.
# Ne retirer ou mettre à "0" que pour un lancement réel explicitement validé.
NO_API=1

# Accusé explicite requis par call-guard.js pour tout appel réel. Absent par
# défaut : ne jamais le définir dans ce fichier d'exemple ni dans une image.
# PIPELINE_REAL_CALLS_ACK=1

# --- Fournisseurs IA (requis uniquement si NO_API n'est pas "1") ---
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=

# --- Réglage optionnel du Visual Director (valeur par défaut si absent) ---
# VISUAL_DIRECTOR_BATCH_SIZE=

# --- Variables documentées mais non lues par le pipeline de rendu automatisé
#     à ce jour (confirmé par recherche dans le code — recherche/génération de
#     médias visuels non automatisée, cf. audit B2-CLOUD) ---
# PEXELS_API_KEY=
# GOOGLE_API_KEY=

# --- Hors périmètre de ce worker (pont local YouTube Agent, non empaqueté
#     ici) : YOUTUBE_AGENT_BRIDGE_TOKEN, YOUTUBE_OAUTH_*, etc. ---
