{
  "web_search": {
    "enabled": true,
    "type": "web_search_20250305",
    "name": "web_search",
    "max_uses": 5
  },
  "source_policy": {
    "allowed_source_types": ["primary", "secondary"],
    "preferred_source_types": ["primary"],
    "source_types": {
      "primary": {
        "label": "source primaire",
        "plural_label": "sources primaires",
        "examples": "organismes publics, instituts statistiques, universités, publications scientifiques et institutions officielles"
      },
      "secondary": {
        "label": "source secondaire",
        "plural_label": "sources secondaires"
      }
    },
    "require_sources_for_key_facts": true,
    "allow_unsourced_claims": false,
    "mark_unverified_claims": true,
    "minimum_sources": 5,
    "target_sources": 8,
    "maximum_sources": 15,
    "max_sources_per_fact": 2,
    "source_tiers": {
      "minimum_rank_for_high_facts": 2,
      "categories": {
        "government": { "tier": 1, "label": "Gouvernement" },
        "official_body": { "tier": 1, "label": "Organisme officiel" },
        "university": { "tier": 1, "label": "Université" },
        "research_institute": { "tier": 1, "label": "Institut de recherche" },
        "scientific_publication": { "tier": 1, "label": "Publication scientifique" },
        "reference_media": { "tier": 2, "label": "Média de référence" },
        "editorial_encyclopedia": { "tier": 2, "label": "Encyclopédie éditoriale" },
        "official_technical_documentation": { "tier": 2, "label": "Documentation technique officielle" },
        "company": { "tier": 3, "label": "Entreprise" },
        "commercial_documentation": { "tier": 3, "label": "Documentation commerciale" },
        "research_firm": { "tier": 3, "label": "Cabinet d'étude identifié" },
        "sponsored_content": { "tier": 3, "label": "Contenu sponsorisé identifié" },
        "wikipedia": { "tier": 4, "label": "Wikipédia" },
        "blog": { "tier": 5, "label": "Blog" },
        "personal_site": { "tier": 5, "label": "Site personnel" },
        "popular_science": { "tier": 5, "label": "Vulgarisation" },
        "forum": { "tier": 6, "label": "Forum" }
      },
      "path_rules": [
        { "contains": "partner-content", "category": "sponsored_content" },
        { "contains": "sponsored", "category": "sponsored_content" },
        { "contains": "publi-redactionnel", "category": "sponsored_content" },
        { "contains": "contenu-sponsorise", "category": "sponsored_content" }
      ],
      "domain_exceptions": {
        "insee.fr": "official_body",
        "un.org": "official_body",
        "oecd.org": "official_body",
        "worldbank.org": "official_body",
        "cnrs.fr": "research_institute",
        "ird.fr": "research_institute",
        "csiro.au": "research_institute",
        "doi.org": "scientific_publication",
        "nature.com": "scientific_publication",
        "science.org": "scientific_publication",
        "britannica.com": "editorial_encyclopedia",
        "universalis.fr": "editorial_encyclopedia",
        "larousse.fr": "editorial_encyclopedia",
        "bbc.com": "reference_media",
        "bbc.co.uk": "reference_media",
        "abc.net.au": "reference_media",
        "lemonde.fr": "reference_media",
        "nationalgeographic.com": "reference_media",
        "nationalgeographic.fr": "reference_media",
        "wikipedia.org": "wikipedia",
        "wikimedia.org": "wikipedia",
        "medium.com": "blog",
        "substack.com": "blog",
        "reddit.com": "forum",
        "quora.com": "forum"
      },
      "excluded_suffixes": [
        ".act.edu.au",
        ".nsw.edu.au",
        ".nt.edu.au",
        ".qld.edu.au",
        ".sa.edu.au",
        ".tas.edu.au",
        ".vic.edu.au",
        ".wa.edu.au"
      ],
      "suffix_rules": [
        { "suffix": ".gouv.fr", "category": "government" },
        { "suffix": ".gov", "category": "government" },
        { "suffix": ".gov.au", "category": "government" },
        { "suffix": ".gov.uk", "category": "government" },
        { "suffix": ".gc.ca", "category": "government" },
        { "suffix": ".europa.eu", "category": "official_body" },
        { "suffix": ".int", "category": "official_body" },
        { "suffix": ".edu", "category": "university" },
        { "suffix": ".edu.au", "category": "university" },
        { "suffix": ".ac.uk", "category": "university" }
      ],
      "prefix_rules": [
        { "prefix": "forum.", "category": "forum" },
        { "prefix": "forums.", "category": "forum" },
        { "prefix": "blog.", "category": "blog" }
      ]
    }
  },
  "title_validation": {
    "alternative_titles_count": 3,
    "approximate_figure_tolerance": 0.1,
    "approximation_window_words": 2,
    "markers": {
      "approximation": ["presque", "environ", "près de", "quasi", "quasiment", "pratiquement", "à peu près", "autour de", "plus de", "moins de"],
      "journalistic": ["vide", "secret", "secrets", "incroyable", "mystère", "mystérieux", "caché", "cachée", "choquant", "fou", "folle", "impossible", "vérité"],
      "hypothesis": ["et si", "peut-être", "pourrait", "pourraient", "serait", "seraient", "probablement", "sans doute"],
      "causality": ["pourquoi", "parce que", "à cause de", "explique", "expliquent", "comment", "raison", "raisons"],
      "generalization": ["tous", "toutes", "toujours", "jamais", "aucun", "aucune", "personne", "seul", "seule", "le plus", "la plus", "les plus", "entièrement", "totalement", "chaque"]
    }
  },
  "fact_evidence": {
    "fetch_timeout_ms": 15000,
    "max_bytes": 2000000,
    "user_agent": "NomadStudio-EvidenceReader/1.0 (lecture locale des preuves citées)",
    "min_text_length": 200,
    "accepted_content_types": ["text/html", "application/xhtml+xml", "text/plain"],
    "excerpt_chars": 400,
    "max_excerpts_per_source": 3,
    "judge_batch_size": 8
  },
  "contradictions": {
    "note_fields": ["executive_summary", "story_angles", "sections", "visual_opportunities", "claims_requiring_sources", "uncertainties"],
    "min_shared_words": 2,
    "min_word_length": 5,
    "compatibility_dimensions": ["date", "portée", "géographie", "définition", "unité"]
  }
}
